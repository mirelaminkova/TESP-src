# Managed by Ansible (TESP-src). Do not edit by hand.
#
# Deployment compose for TESP-API (GA4GH TES -> Pulsar bridge).
# Brought up with: docker compose -f docker-compose.deploy.yml up -d --build
#
#   TES client --HTTPS--> nginx (host, /tes/) --> gateway --> tesp-api:8080
#   gateway answers /v1/service-info itself (issue #25)
#   tesp-api --> pulsar-proxy (injects private_token) --> host Pulsar :8913 --> SLURM
#   tesp-api --> tesp-db (MongoDB)
#
# Based on the fork's docker-compose.yaml (same build target and /app mount),
# minus its test-only parts: the pulsar_rest and MinIO services, the MinIO S3
# credentials, and the staging volume shared with pulsar_rest. Pulsar runs on
# the host here. S3 is configured in settings.toml and, for the key pair, in
# {{ tesp_secrets_file }}, mounted below; neither goes in this file.
services:
  tesp-api:
    build:
      context: ./
      dockerfile: docker/tesp_api/Dockerfile
      target: development
    image: tesp-api
    container_name: tesp-api
    restart: unless-stopped
    privileged: true
    environment:
      - FASTAPI_PROFILE=src
      - CONTAINER_TYPE={{ tesp_container_type }}
    # --root-path makes FastAPI/Swagger generate correct URLs behind the /tes/ proxy.
    command: ["uvicorn", "--host=0.0.0.0", "--port=8080", "--root-path={{ tesp_root_path }}", "tesp_api.tesp_api:app"]
    # No host port: reached only through the gateway, on the stack's network.
    depends_on:
      - tesp-db
      - pulsar-proxy
    volumes:
      - ./:/app
      # Read by Dynaconf next to settings.toml. Kept outside ./ so that
      # `COPY . .` in the image build never picks it up.
      - {{ tesp_secrets_file }}:/app/.secrets.toml:ro

  gateway:
    image: {{ tesp_nginx_image }}
    container_name: tesp-gateway
    restart: unless-stopped
    # nginx reads its config only at start. A changed config changes this
    # label, so `docker compose up` recreates the container.
    labels:
      tesp.gateway-config-checksum: "{{ tesp_gateway_conf_checksum | default('') }}"
    # Only bound to localhost; public access goes through the host nginx at {{ tesp_root_path }}/.
    ports:
      - "127.0.0.1:{{ tesp_api_port }}:8080"
    depends_on:
      - tesp-api
{% if tesp_oauth_enabled | bool %}
      - validator
    networks:
      - default
      - auth
{% endif %}
    # The whole directory, not single files: Ansible replaces a file with a
    # new one, which a single-file bind mount would not see.
    volumes:
      - {{ tesp_gateway_dir }}:/etc/nginx/conf.d:ro

{% if tesp_oauth_enabled | bool %}
  # Checks OAuth2 access tokens for the gateway (issue #26). Built from
  # files/tes-validator, copied to {{ tesp_validator_dir }}. No port: only
  # the gateway calls it, on the stack's network.
  validator:
    build:
      context: {{ tesp_validator_dir }}
    image: tesp-validator
    container_name: tesp-validator
    restart: unless-stopped
    read_only: true
    # The playbook waits for it (wait: true), so a validator that doesn't start
    # fails the deploy instead of every request.
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8081/healthz', timeout=3)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    cap_drop:
      - ALL
    security_opt:
      - no-new-privileges:true
    labels:
      tesp.validator-config-checksum: "{{ tesp_validator_conf_checksum | default('') }}"
    # Only the gateway can reach it (its own network, with internet access for
    # the issuer); tesp-api and pulsar-proxy can't.
    networks:
      - auth
    volumes:
      - {{ tesp_gateway_dir }}/validator:/etc/tes-validator:ro
{% if tesp_oauth_ca_bundle %}
      # The directory, not the file: an updated bundle is a new file, which a
      # single-file mount would not see.
      - {{ tesp_oauth_ca_bundle | dirname }}:/etc/tes-validator-ca:ro
    environment:
      # Python's ssl (urllib) reads it instead of the image's bundle.
      - SSL_CERT_FILE=/etc/tes-validator-ca/{{ tesp_oauth_ca_bundle | basename }}
{% endif %}

{% endif %}
  tesp-db:
    image: mongo:8.0
    container_name: tesp-db
    restart: unless-stopped
    environment:
      - MONGO_INITDB_DATABASE=tesp
    volumes:
      - ./docker/mongodb/data:/data/db

  pulsar-proxy:
    image: {{ tesp_nginx_image }}
    container_name: tesp-pulsar-proxy
    restart: unless-stopped
    labels:
      # sha256 of pulsar-token-proxy.conf (playbook.yml): a changed config
      # changes the service, so Compose recreates the container, which then
      # reads the new file. nginx reads it only at start.
      tesp.pulsar-proxy-conf-sha256: "{{ tesp_pulsar_proxy_conf_checksum }}"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    volumes:
      - {{ tesp_pulsar_proxy_conf }}:/etc/nginx/conf.d/default.conf:ro

# Some cloud providers (incl. SURF Research Cloud) require a lower MTU.
networks:
  default:
    driver: bridge
    driver_opts:
      com.docker.network.driver.mtu: {{ tesp_network_mtu }}
{% if tesp_oauth_enabled | bool %}
  auth:
    driver: bridge
    driver_opts:
      com.docker.network.driver.mtu: {{ tesp_network_mtu }}
{% endif %}
