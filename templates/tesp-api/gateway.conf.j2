# Managed by Ansible (TESP-src). Do not edit by hand.
#
# TES gateway (issue #25), between the host nginx (/tes/, prefix stripped)
# and tesp-api:
#   - GET /v1/service-info is answered here, from service-info.json next to
#     this file: tesp-api's own answer is hard-coded for another provider.
#   - The API docs (Swagger UI, ReDoc, the OpenAPI document) go to tesp-api
#     without credentials, as before.
#   - Everything else goes to tesp-api unchanged, Authorization included;
#     tesp-api checks the HTTP Basic credentials itself. A request without
#     Basic credentials gets 401 here: tesp-api (c3a9f23) would answer it
#     with a 500 (it reads the missing credentials' username).

# Docker's embedded DNS. proxy_pass with a variable makes nginx resolve
# tesp-api per request, so a recreated tesp-api container (new address) is
# found. Without a URI part, the request URI goes on as received, still
# percent-encoded; the host nginx in front has normalised it already. Not
# $uri: it is decoded and nginx doesn't re-encode it, so %0d%0a in a path
# would reach tesp-api as a raw line break (header injection).
resolver 127.0.0.11 valid=2s ipv6=off;

# The scheme, one space and credentials, as tesp-api (FastAPI) parses them.
map $http_authorization $tes_has_basic {
    "~*^basic [^ ]"  1;
    default          0;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;

    # The host nginx in front enforces the request size limit.
    client_max_body_size 0;

    set $tesp_api_upstream http://tesp-api:8080;
    proxy_http_version 1.1;
    # The Host the host nginx sent, as tesp-api saw it before the gateway.
    proxy_set_header Host $http_host;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location = /v1/service-info {
        add_header Allow "GET, HEAD" always;
        if ($request_method !~ ^(GET|HEAD)$) {
            return 405;
        }
        default_type application/json;
        alias /etc/nginx/conf.d/service-info.json;
    }

    # So tesp-api's hard-coded answer is never reachable. A rewrite, because
    # nginx serves a URI ending in / as a directory.
    location = /v1/service-info/ {
        rewrite ^ /v1/service-info last;
    }

    location ~ ^/(|swagger-ui\.html|redoc|openapi\.json|docs/oauth2-redirect)$ {
        proxy_pass $tesp_api_upstream;
    }

    location / {
        if ($tes_has_basic = 0) {
            return 401;
        }
        proxy_pass $tesp_api_upstream;
    }

    error_page 401 = @unauthorized;
    location @unauthorized {
        add_header WWW-Authenticate 'Basic realm="tes"' always;
        default_type application/json;
        return 401 '{"detail": "Not authenticated"}';
    }
}
