# Managed by Ansible (TESP-src). Do not edit by hand.
#
# Deployed to {{ tesp_secrets_file }} (root, 0600) and bind-mounted into the
# tesp-api container as /app/.secrets.toml, which tesp-api's Dynaconf loads
# after settings.toml and merges in (settings_files in the fork's
# tesp_api/config/properties.py). It holds the S3 key
# pair from the src_s3_access_key_id and src_s3_secret_access_key component
# parameters; both empty means anonymous S3 access (public buckets only).
# tesp-api only uses the key to presign URLs; it never reaches task containers.
[default]
s3.access_key_id = {{ tesp_s3_access_key_id | to_json }}
s3.secret_access_key = {{ tesp_s3_secret_access_key | to_json }}
