# Managed by Ansible (TESP-src). Do not edit by hand.
#
# Deployed to {{ tesp_settings_file }} (root, 0600) and bind-mounted
# read-only over the tesp-api checkout's settings.toml, so it must define every
# setting the app reads (see "Configuration notes" in the README when bumping
# tesp_api_version), except the S3 key pair, which is in .secrets.toml. The
# stack runs with FASTAPI_PROFILE=src; Dynaconf merges [src] over [default].
# [src] repeats the deployment-critical values; the rest (pulsar.status.*,
# logging.level, oauth, s3.*, pulsar.native_specification.*,
# container.resource_limits) comes from [default].
#
# TESP-API talks to the host Pulsar through the `pulsar-proxy` sidecar, which
# injects Pulsar's private_token into every request (tesp-api itself cannot
# send the token). MongoDB and the proxy are reached by their compose service
# names on the stack's internal network.
[default]
db.mongodb_uri = "mongodb://tesp-db:27017"
pulsar.url = "http://pulsar-proxy:8913"
# How tesp-api waits for Pulsar jobs; see "Long tasks" in the README. The
# deprecated pulsar.status.max_polls is left out: it is ignored and would log a
# warning at startup.
pulsar.status.poll_interval = 4
pulsar.status.max_poll_interval = 60
pulsar.status.max_wait_seconds = {{ tesp_max_wait_seconds | int }}
pulsar.status.error_retry_seconds = 600
pulsar.client_timeout = 30
# Per-job SLURM options; tesp-api fills in the {placeholders} per task. See
# "Resource limits" in the README.
pulsar.native_specification.cpu_cores = {{ tesp_native_spec_cpu_cores | to_json }}
pulsar.native_specification.ram_gb = {{ tesp_native_spec_ram_gb | to_json }}

# "auto": no --cpus/--memory for Apptainer (see "Resource limits").
container.resource_limits = {{ tesp_container_resource_limits | to_json }}

logging.level = "INFO"
logging.output_json = false

oauth.enable = false
basic_auth.enable = true
basic_auth.username = "{{ tesp_basic_auth_user }}"
basic_auth.password = "{{ tesp_basic_auth_password }}"

# S3 inputs and outputs given as s3://bucket/key (validated at startup), set
# from the src_s3_* component parameters. An empty endpoint means AWS S3.
# s3.access_key_id and s3.secret_access_key are not in this file: they come
# from /app/.secrets.toml, bind-mounted from the root-only tesp_secrets_file
# (empty there = anonymous access, i.e. public buckets only).
s3.endpoint_url = {{ tesp_s3_endpoint_url | to_json }}
s3.region = {{ tesp_s3_region | to_json }}
s3.addressing_style = {{ tesp_s3_addressing_style | to_json }}
s3.presign_expiry_seconds = {{ tesp_s3_presign_expiry_seconds | int }}
s3.output_presign_expiry_seconds = {{ tesp_s3_output_presign_expiry_seconds | int }}

[src]
db.mongodb_uri = "mongodb://tesp-db:27017"
pulsar.url = "http://pulsar-proxy:8913"
logging.output_json = false
basic_auth.enable = true
basic_auth.username = "{{ tesp_basic_auth_user }}"
basic_auth.password = "{{ tesp_basic_auth_password }}"
