#!/bin/bash
# Prints whether Pulsar runs with the config on disk:
#   current  Pulsar is active and started after every file in its config dir
#   stale    a config file is newer (same second counts: an extra restart is
#            harmless, a missed one breaks every task), Pulsar isn't active,
#            never started (also a masked unit), or its config directory is
#            missing; a masked or broken unit then fails the restart, visibly
#   missing  systemd has no such unit (LoadState not-found): a fresh host
#            under --check
# A config file with a future mtime (clock skew) keeps it "stale", so Pulsar
# restarts on every run until the clock passes it: harmless.
# Rendered into the "Check whether Pulsar runs with its current config" task
# in playbook.yml; tests/render-templates.yml runs it against stub busctl
# and systemctl.
# Needs the D-Bus system bus (dbus.service, part of Ubuntu); without it
# busctl fails and so does the play.
# Timestamps come from systemd's D-Bus API as microseconds since the epoch,
# so nothing parses a localized date: `systemctl show` prints local time,
# which is ambiguous in the DST fall-back hour and has zone names `date`
# may reject (issue #35).
set -euo pipefail
unit={{ (pulsar_systemd_service_name | default('pulsar') ~ '.service') | quote }}
dir={{ pulsar_config_dir | quote }}
# LoadUnit gives the unit's object path, also for a unit that doesn't exist.
path=$(busctl call org.freedesktop.systemd1 /org/freedesktop/systemd1 \
  org.freedesktop.systemd1.Manager LoadUnit s "$unit")
path=${path#o \"}; path=${path%\"}
prop() { busctl get-property org.freedesktop.systemd1 "$path" org.freedesktop.systemd1.Unit "$1"; }
load=$(prop LoadState); load=${load#s \"}; load=${load%\"}
if [ "$load" = not-found ]; then echo missing; exit 0; fi
state=$(prop ActiveState); state=${state#s \"}; state=${state%\"}
started=$(prop ActiveEnterTimestamp); started=${started#t }
started=$((started / 1000000))
# systemd keeps ActiveEnterTimestamp after a unit stops, so check the state.
if [ "$state" != active ] || [ ! -d "$dir" ]; then
  echo stale
  exit 0
fi
newest=$(find "$dir" -maxdepth 1 -type f -printf '%T@\n' | sort -n | tail -n 1)
newest=${newest%.*}
if [ "${newest:-0}" -ge "$started" ]; then echo stale; else echo current; fi
